# ─── Aplicación ────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000

# ─── Seguridad ─────────────────────────────────────────────
# Orígenes autorizados (CORS), separados por comas. Nunca "*".
CORS_ORIGENES=http://localhost:4200
# true solo si la API está detrás de Cloudflare u otro proxy de confianza
CONFIAR_PROXY=false
# Documentación OpenAPI en /api/docs (desactivar en producción si no se necesita)
DOCS_HABILITADOS=true
# Límite global de peticiones por IP
RATE_LIMIT_MAX=300
RATE_LIMIT_VENTANA=1 minute

# ─── Observabilidad (opcional) ─────────────────────────────
# Si se dejan vacíos, Sentry queda desactivado.
SENTRY_DSN=
SENTRY_DSN_WEB=
SENTRY_ENTORNO=desarrollo

# ─── Base de datos ─────────────────────────────────────────
# PostgreSQL en Neon (región São Paulo). Copiar ambas cadenas desde la consola de Neon.
# Fuera de localhost la API exige sslmode=verify-full o require (conexión cifrada; verify-full valida el certificado).
# Conexión con pooler (host con "-pooler"): la usa la aplicación.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.sa-east-1.aws.neon.tech/dely_pagos?sslmode=verify-full"
# Conexión directa (host sin "-pooler"): la usan las migraciones.
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.sa-east-1.aws.neon.tech/dely_pagos?sslmode=verify-full"

# Contraseña de los usuarios de demo (mínimo 12 caracteres).
# Si se deja vacía, el seed genera una aleatoria y la muestra una sola vez.
SEED_CLAVE_DEMO=

# ─── Proveedor bancario ────────────────────────────────────
# mock | bcp-rest | bcp-h2h
BANK_PROVIDER=mock

# Simulador (solo BANK_PROVIDER=mock): intervalo aleatorio entre movimientos, en segundos
MOCK_INTERVALO_MIN_S=10
MOCK_INTERVALO_MAX_S=40

# BCP REST (pendiente de convenio; valores los entrega el banco)
BCP_REST_BASE_URL=
BCP_REST_CLIENT_ID=
BCP_REST_CLIENT_SECRET=
BCP_REST_SCOPE=

# BCP Host-to-Host / Telecrédito (pendiente de convenio)
BCP_H2H_CARPETA_ENTRADA=./datos/h2h/entrada
BCP_H2H_SFTP_HOST=
BCP_H2H_SFTP_PUERTO=22
BCP_H2H_SFTP_USUARIO=
BCP_H2H_SFTP_CLAVE_PRIVADA=

# ─── Conciliación ──────────────────────────────────────────
CONCILIACION_PESO_MONTO=0.35
CONCILIACION_PESO_NOMBRE=0.25
CONCILIACION_PESO_REFERENCIA=0.20
CONCILIACION_PESO_CUENTA_ORIGEN=0.20
CONCILIACION_UMBRAL_CONCILIADO=0.85
CONCILIACION_UMBRAL_PROBABLE=0.60
CONCILIACION_VENTANA_PEDIDO_MIN=30

# ─── Notificaciones ────────────────────────────────────────
# Si faltan credenciales, se usa el canal simulado (bandeja visible en la web).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
