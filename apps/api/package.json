{
  "name": "@dely/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:generar": "prisma generate",
    "db:migrar": "prisma migrate dev",
    "db:desplegar": "prisma migrate deploy",
    "db:estudio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@sentry/node": "^11.1.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "prisma": "~7.10.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.2"
  }
}
